# Run python3 scripts/init-local.py to create .env with unique local credentials.
POSTGRES_PASSWORD=replace-with-a-random-password
BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_PASSWORD=replace-with-a-random-password
WEB_PORT=8787
APP_ENV=development
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8787,http://127.0.0.1:8787
# Offline transcription; weights are prepared separately with scripts/prepare-stt-model.py.
STT_MODEL_DIR=whisper-small
STT_CPU_THREADS=4
STT_MEMORY_LIMIT=4g
STT_CPU_LIMIT=4

# RAG defaults: OpenAI Luna with max reasoning. See docs/rag.md for local-only deployment.
RAG_OFFLINE=false
RAG_LLM_PROVIDER=openai
RAG_LLM_MODEL=gpt-5.6-luna
RAG_REASONING_EFFORT=max
OPENAI_API_KEY=
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
RAG_EMBEDDING_REVISION=1
RAG_LOCAL_URL=http://host.docker.internal:11434
RAG_LOCAL_API_KEY=
